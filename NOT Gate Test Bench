module not_gate_tb();
  reg a;
  reg b;
  not_gate n1(a,b);
  initial 
    begin a=1'b0;
      $display("%b",a);
      #10 a=1'b1;
      $display("%b,%b",a,b);
      #10 a=1'b0;
      $display("%b,%b",a,b);
      #35 $finish();
    end
  initial
    begin
      $dumpfile("dump.vcd");
      $dumpvars();
    end
endmodule
